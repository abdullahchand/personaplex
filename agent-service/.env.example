# Copy to .env and fill in values

# GPT (OpenAI or compatible)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WEBHOOK_VERIFY_TOKEN=your_random_verify_token

# Public URL for webhook (e.g. https://your-domain.com)
BASE_URL=https://your-domain.com

# Optional: model for enhancement vs agent
OPENAI_MODEL_ENHANCE=gpt-4o-mini
OPENAI_MODEL_AGENT=gpt-4o-mini
