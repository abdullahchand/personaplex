# Copy to .env and fill in values

# GPT (OpenAI or compatible)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# WhatsApp Cloud API (Meta) – pywa
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WEBHOOK_VERIFY_TOKEN=your_random_verify_token
# Optional: for callback URL registration and update validation
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=

# Public URL for webhook (e.g. https://your-domain.com)
BASE_URL=https://your-domain.com

# Optional: model for cleanup vs WhatsApp agent
OPENAI_MODEL_ENHANCE=gpt-4o-mini
OPENAI_MODEL_AGENT=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Your HTTPS endpoint: receives JSON { "prompt", "raw_transcript", "phone" }
BUILD_WEBHOOK_URL=

# When set, POST /handoff requires header x-handoff-secret (PersonaPlex HANDOFF_SHARED_SECRET)
HANDOFF_SHARED_SECRET=
